# Description: Environment variables overwriting the default values for docker compose

# Data Ingestion
## API
DATA_INGESTION_HOST=data-ingestion
DATA_INGESTION_PORT=80

# Pipelines
## API
PIPELINES_HOST=pipelines
PIPELINES_PORT=80


# App-backend
## API
APP_BACKEND_HOST=app-backend
APP_BACKEND_PORT=80

# App-frontend
## API
APP_FRONTEND_URL=app-frontend
APP_FRONTEND_PORT=80

# DATABASE
DB_HOST=postgres
DB_PORT=5432